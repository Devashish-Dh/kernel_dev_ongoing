diff --git a/kernel/syscall1_os_assg.c b/kernel/syscall1_os_assg.c
new file mode 100644
index 000000000..88781add3
--- /dev/null
+++ b/kernel/syscall1_os_assg.c
@@ -0,0 +1,82 @@
+#include <linux/syscalls.h>
+#include <linux/errno.h>
+#include <linux/sched.h>
+#include <linux/mm.h>        // for mmap_lock and mm_struct 
+#include <linux/mman.h>      // for PAGE_ALIGNED 
+#include <linux/uaccess.h>   // for copy_from_user and copy_to_user
+
+// Syscall: square a number and print info
+// SYSCALL_DEFINE1(mapping_phase, int, x)
+// {
+//     pr_info("hello world FROM SYS_CALL 1 !\n\n\n");
+//     if (x < 0)
+//         return -EINVAL;
+//     return x * x;
+// }
+
+// // Syscall: Implementation of the prefault operation:
+// SYSCALL_DEFINE4(mapping_phase, void __user *, buff1, void __user *, buff2, size_t, len, int, operation)  
+// {  
+//     // Implementation for prefault operation  
+//     // operation should be OP_ARM (1)  
+//     return 0;  
+// }  
+
+#define OP_ARM 1
+
+SYSCALL_DEFINE4(mapping_phase, void __user *, buff1, void __user *, buff2, size_t, len, int, operation)  
+{  
+    struct mm_struct *mm = current->mm;
+    unsigned long b1 = (unsigned long)buff1;
+    unsigned long b2 = (unsigned long)buff2;
+
+    // only run if the operation is OP_ARM
+    if (operation != OP_ARM) {
+        return -EINVAL; // Invalid operation for this syscall
+    }
+
+    // alignment Check: MMU works with page granularity 
+    // if addresses are not 4KB aligned, math will fail
+    if (!PAGE_ALIGNED(b1) || !PAGE_ALIGNED(b2) || !PAGE_ALIGNED(len)) {
+        pr_err("mapping_phase: Buffers or length not page-aligned\n");
+        return -EINVAL;
+    }
+
+    // acquire mmap_lock : 
+    // use the 'write' version because we are modifying the mm_struct
+    // 'killable' allows the process to be interrupted if the lock is contested
+    if (mmap_write_lock_killable(mm))
+        return -EINTR;
+
+    // logic based on Operation 
+    if (operation == 1) { // OP_ARM
+        // verify the VMAs exist to catch obvious userspace errors
+        if (!find_vma(mm, b1) || !find_vma(mm, b2)) {
+            mmap_write_unlock(mm);
+            return -EFAULT;
+        }
+
+        mm->osAssgBuffer1 = b1;
+        mm->osAssgBuffer2 = b2;
+        mm->osAssgLenOfBothBuffers = (unsigned long)len; // number of pages!
+        
+        pr_info("mapping_phase: Armed mirroring for 0x%lx -> 0x%lx (len: %zu)\n", 
+                b1, b2, len);
+    } 
+    else if (operation == 0) { // OP_DISARM
+        mm->osAssgBuffer1 = 0;
+        mm->osAssgBuffer2 = 0;
+        mm->osAssgLenOfBothBuffers = 0;
+        
+        pr_info("mapping_phase: Disarmed mirroring logic\n");
+    } 
+    else {
+        mmap_write_unlock(mm);
+        return -EINVAL;
+    }
+
+    // release Lock
+    mmap_write_unlock(mm);
+    
+    return 0;  
+}
diff --git a/kernel/syscall2_os_assg.c b/kernel/syscall2_os_assg.c
new file mode 100644
index 000000000..7be46ff64
--- /dev/null
+++ b/kernel/syscall2_os_assg.c
@@ -0,0 +1,381 @@
+#include <linux/syscalls.h>   // for SYSCALL_DEFINE* macros
+#include <linux/errno.h>      // standard error codes like -EINVAL
+#include <linux/sched.h>      // for current task_struct
+#include <linux/uaccess.h>   // for copy_from_user and copy_to_user
+#include <linux/mm.h>        // for mmap_lock and mm_struct
+#include <linux/mman.h>      // for PAGE_ALIGNED
+#include <linux/mm_types.h>
+#include <linux/rmap.h>
+#include <linux/slab.h>
+#include <linux/highmem.h>
+#include <linux/pgtable.h>
+#include <linux/mmap_lock.h>
+
+// #define DEDUP_DEBUG // Uncomment to enable debug logging for deduplication phase
+
+// Debug macro for merge attempt diagnostics (off by default)
+#ifdef DEDUP_DEBUG
+#define dedup_pr_err(fmt, ...) pr_err(fmt, ##__VA_ARGS__)
+#else
+#define dedup_pr_err(fmt, ...) do { } while (0)
+#endif
+
+// Syscall: cube a number and print info
+// SYSCALL_DEFINE1(dedup_phase, int, x)
+// {
+//     pr_info("hello world FROM SYS_CALL 2 !\n\n\n");
+//     if (x < 0)
+//         return -EINVAL;
+//     return x * x * x;
+// }
+
+// // Syscall: Implementation of the de-duplication operation:
+// SYSCALL_DEFINE4(dedup_phase, void __user *, buff1, void __user *, buff2, size_t, len, int, operation)  
+// {  
+//     // Implementation for dedup operation    
+//     // operation should be OP_DEDUP (2)  
+//     return 0;  
+// }
+
+
+
+// structure to track pages and their information for deduplication
+struct track_pg{
+    unsigned long page_addr; // starting address of the page
+    bool is_merged;          // flag to indicate if the page has been merged with an identical page
+    bool is_allocated;       // flag to indicate if the page has been allocated for tracking 
+    struct page* ptr_to_pfn; // pointer to the page struct for reference counting and other operations
+    
+};
+
+
+// func that walks the page tables to find the PTE for a given address 
+//DOES NOT LOCK YET!
+static pte_t *get_pte_ptr_nolock(struct mm_struct *mm, unsigned long addr, spinlock_t **ptl)
+{
+    pgd_t *pgd; p4d_t *p4d; pud_t *pud; pmd_t *pmd;
+    pte_t *pte;
+
+    pgd = pgd_offset(mm, addr);
+    if (pgd_none(*pgd) || pgd_bad(*pgd)) return NULL;
+    p4d = p4d_offset(pgd, addr);
+    if (p4d_none(*p4d) || p4d_bad(*p4d)) return NULL;
+    pud = pud_offset(p4d, addr);
+    if (pud_none(*pud) || pud_bad(*pud)) return NULL;
+    pmd = pmd_offset(pud, addr);
+    if (pmd_none(*pmd) || !pmd_present(*pmd) || pmd_trans_huge(*pmd)) return NULL;
+
+printk(KERN_INFO "OS_ASG: [PTE_WALK] PTE located for address 0x%lx\n", addr);
+
+    // In 6.19, pte_offset_map requires RCU or a lock. 
+    // Since we call this under mmap_lock, it's generally safe, 
+    // but pte_offset_map() now returns a pointer that MUST be pte_unmap()ed.
+    pte = pte_offset_map(pmd, addr);
+    if (!pte) return NULL;
+
+    *ptl = pte_lockptr(mm, pmd);
+    return pte;
+}
+
+// Helper that walks page tables AND acquires the PTE spinlock
+static pte_t *get_pte_ptr(struct mm_struct *mm, unsigned long addr, spinlock_t **ptl)
+{
+    pgd_t *pgd; p4d_t *p4d; pud_t *pud; pmd_t *pmd;
+
+    pgd = pgd_offset(mm, addr);
+    if (pgd_none(*pgd) || pgd_bad(*pgd)) return NULL;
+    p4d = p4d_offset(pgd, addr);
+    if (p4d_none(*p4d) || p4d_bad(*p4d)) return NULL;
+    pud = pud_offset(p4d, addr);
+    if (pud_none(*pud) || pud_bad(*pud)) return NULL;
+    pmd = pmd_offset(pud, addr);
+    if (pmd_none(*pmd) || !pmd_present(*pmd) || pmd_trans_huge(*pmd)) return NULL;
+
+    // This is the key difference: it maps the PTE and returns it with the lock held
+    return pte_offset_map_lock(mm, pmd, addr, ptl);
+}
+
+static int are_pages_identical(struct page *p1, struct page *p2) {
+    void *v1, *v2;
+    int ret;
+
+    if (p1 == p2) return 1; // Same physical page?
+
+    v1 = kmap_local_page(p1);
+    v2 = kmap_local_page(p2);
+            
+    ret = (memcmp(v1, v2, PAGE_SIZE) == 0);
+
+    kunmap_local(v2);
+    kunmap_local(v1);
+
+    return ret; // 1 if identical, 0 otherwise
+}
+
+
+
+
+
+
+// func to execute the actual PTE merge and write-protection logic for two identical pages
+// Updated execute_pte_merge with RCU and Corrected Logic
+static int execute_pte_merge(struct mm_struct *mm, struct track_pg *pg1, struct track_pg *pg2) {
+    pte_t *ptep1 = NULL, *ptep2 = NULL;
+    spinlock_t *ptl1 = NULL, *ptl2 = NULL;
+    pte_t entry;
+    struct folio *folio1, *folio2;
+    int ret = -ESTALE;
+
+    struct vm_area_struct *vma1 = vma_lookup(mm, pg1->page_addr);
+    struct vm_area_struct *vma2 = vma_lookup(mm, pg2->page_addr);
+
+    if (!vma1 || !vma2) return -EFAULT;
+    // Reject Shared/File VMAs
+    if ((vma1->vm_flags & VM_SHARED) || (vma2->vm_flags & VM_SHARED)) return -EINVAL;
+    
+    // 6.19 RCU Protection for PTE Walk
+    rcu_read_lock();
+
+    ptep1 = get_pte_ptr_nolock(mm, pg1->page_addr, &ptl1);
+    ptep2 = get_pte_ptr_nolock(mm, pg2->page_addr, &ptl2);
+
+    if (!ptep1 || !ptep2) {
+        ret = -EFAULT;
+        goto unlock_rcu;
+    }
+
+    // Stable PTL Ordering (Addresses critique #1)
+    if (ptl1 < ptl2) {
+        spin_lock(ptl1);
+        spin_lock_nested(ptl2, SINGLE_DEPTH_NESTING);
+    } else if (ptl1 > ptl2) {
+        spin_lock(ptl2);
+        spin_lock_nested(ptl1, SINGLE_DEPTH_NESTING);
+    } else {
+        spin_lock(ptl1);
+    }
+
+    // Stability Checks
+    if (!pte_present(*ptep1) || !pte_present(*ptep2)) goto unlock;
+
+    folio1 = page_folio(pte_page(*ptep1));
+    folio2 = page_folio(pte_page(*ptep2));
+    
+    if (folio1 != page_folio(pg1->ptr_to_pfn) || folio2 != page_folio(pg2->ptr_to_pfn)) goto unlock;
+    if (!folio_test_anon(folio1) || !folio_test_anon(folio2)) { ret = -EINVAL; goto unlock; }
+    if (folio_mapcount(folio2) != 1) { ret = -EADDRINUSE; goto unlock; }
+
+    // Write-Protect Both (Addresses critique #2)
+    if (pte_write(*ptep1)) ptep_set_wrprotect(mm, pg1->page_addr, ptep1);
+    if (pte_write(*ptep2)) ptep_set_wrprotect(mm, pg2->page_addr, ptep2);
+
+    entry = pte_wrprotect(*ptep1);
+    ptep_clear_flush(vma2, pg2->page_addr, ptep2);    
+    set_pte_at(mm, pg2->page_addr, ptep2, entry);
+
+	// RMAP (6.19 API Alignment)
+    folio_get(folio1);
+
+    // We pass the specific page from the PTE of the address 
+    // to map/unmap correctly within the folio.
+    folio_add_anon_rmap_pte(folio1, pte_page(*ptep1), vma2, pg2->page_addr, RMAP_NONE);
+    folio_remove_rmap_pte(folio2, pte_page(*ptep2), vma2);
+
+    folio_put(folio2);
+
+
+    ret = 0; 
+
+unlock:
+    if (ptl1 == ptl2) {
+        spin_unlock(ptl1);
+    } else {
+        spin_unlock(ptl1);
+        spin_unlock(ptl2);
+    }
+unlock_rcu:
+    if (ptep1) pte_unmap(ptep1);
+    if (ptep2) pte_unmap(ptep2);
+    rcu_read_unlock();
+    return ret;
+}
+
+
+
+
+
+
+
+
+
+#define OP_DEDUP 2
+
+SYSCALL_DEFINE4(dedup_phase, void __user *, buff1, void __user *, buff2, size_t, len, int, operation)  
+{ 
+    //len is in BYTES!
+    struct mm_struct *mm = current->mm;
+    unsigned long mm_b1 = mm->osAssgBuffer1;
+    unsigned long mm_b2 = mm->osAssgBuffer2;
+    unsigned long mm_len = mm->osAssgLenOfBothBuffers;
+
+    unsigned long b1 = (unsigned long)buff1;
+    unsigned long b2 = (unsigned long)buff2;
+    unsigned long l_buffer = (unsigned long)len;
+
+printk(KERN_INFO "OS_ASG: [START] Dedup Phase initiated for %lu bytes\n", len);
+
+    // ensure the data in the mm_struct is same as passed by the process before proceeding with dedup logic
+    if ( (mm_b1 != b1 || mm_b2 != b2 || mm_len != l_buffer) && (b1 != 0 && b2 != 0 && l_buffer != 0) ) {
+        pr_err("dedup_phase: No valid data found in mm_struct w.r.t buffers\n");
+        return -EINVAL;
+    }
+
+    // only run if the operation is OP_DEDUP
+    if (operation != OP_DEDUP) {
+        pr_err("dedup_phase: Invalid operation %d for deduplication\n", operation);
+        return -EINVAL; // Invalid operation for this syscall
+    }
+
+    // alignment Check: MMU works with page granularity 
+    // if addresses are not 4KB aligned, math will fail
+    if (!PAGE_ALIGNED(b1) || !PAGE_ALIGNED(b2) ) {
+        pr_err("dedup_phase: Buffers or length not page-aligned\n");
+        return -EINVAL;
+    }
+
+    if(l_buffer == 0) {
+        pr_err("dedup_phase: Length of buffers is zero\n");
+        return -EINVAL;
+    }
+
+    if(!(l_buffer/PAGE_SIZE > 0)) {
+        pr_err("dedup_phase: Length of buffers is less than a page\n");
+        return -EINVAL;
+    }
+
+
+
+    // array to track and merge identical pages in buffer 1 and buffer 2
+    struct track_pg *tracked_pages = kvmalloc(2 * (l_buffer / PAGE_SIZE) * sizeof(struct track_pg), GFP_KERNEL); // b1,then b2 in the tracking array
+    if (!tracked_pages) {
+        pr_err("dedup_phase: Failed to allocate memory for page tracking for buffer1\n");
+        return -ENOMEM;
+    }
+    
+    // zero out the tracking array to ensure all pages are initially marked as not tracked
+    memset(tracked_pages, 0, 2 * (l_buffer / PAGE_SIZE) * sizeof(struct track_pg));
+    
+    int count = 0;
+    int merged_total = 0;
+    
+    mmap_read_lock(mm); // lock the mm_struct for reading to safely access page tables without race conditions
+
+    // The first pass to capture state of buffer1 and buffer2 pages in the tracking array
+printk(KERN_INFO "OS_ASG: [0] Starting Scan Pass (mmap_read_lock)\n");
+    // Scan Buffer 1
+    for (size_t i = 0; i < (l_buffer / PAGE_SIZE); i++) {
+        unsigned long addr = b1 + (i * PAGE_SIZE);
+        spinlock_t *ptl;
+        pte_t *ptep = get_pte_ptr(mm, addr, &ptl);
+
+        if (!ptep) continue;
+
+        if (pte_present(*ptep)) {
+            struct page *p = pte_page(*ptep);
+            get_page(p); // pin page for comparison pass
+
+            tracked_pages[count].page_addr = addr;
+            tracked_pages[count].ptr_to_pfn = p;
+            tracked_pages[count].is_merged = false;
+            tracked_pages[count].is_allocated = true;
+            count++;
+        }
+        pte_unmap_unlock(ptep, ptl);
+    }
+
+    // Scan Buffer 2
+    for (size_t i = 0; i < (l_buffer / PAGE_SIZE); i++) {
+        unsigned long addr = b2 + (i * PAGE_SIZE);
+        spinlock_t *ptl;
+        pte_t *ptep = get_pte_ptr(mm, addr, &ptl);
+
+        if (!ptep) continue;
+
+        if (pte_present(*ptep)) {
+            struct page *p = pte_page(*ptep);
+            get_page(p);
+
+            tracked_pages[count].page_addr = addr;
+            tracked_pages[count].ptr_to_pfn = p;
+            tracked_pages[count].is_merged = false;
+            tracked_pages[count].is_allocated = true;
+            count++;
+        }
+        pte_unmap_unlock(ptep, ptl);
+    }
+
+    mmap_read_unlock(mm); // unlock the mm_struct
+printk(KERN_INFO "OS_ASG: [1] Scan Pass Complete. Found %d resident pages.\n", count);
+
+printk(KERN_INFO "OS_ASG: [2] Starting Comparison/Merge Pass\n");
+    // The second pass for compare + merge of identical pages in BOTH buffers using tracking array 
+    for (int i = 0; i < count; i++) {
+            if (!tracked_pages[i].is_allocated || tracked_pages[i].is_merged) 
+                continue; // skip pages that are not allocated or already merged
+
+            for (int j = i + 1; j < count; j++) {
+                if (!tracked_pages[j].is_allocated || tracked_pages[j].is_merged) 
+                    continue; // skip pages that are not allocated or already merged
+
+                if (tracked_pages[i].ptr_to_pfn == tracked_pages[j].ptr_to_pfn) { // same physical page, no need to compare content
+                    tracked_pages[j].is_merged = true;
+                    continue;
+                }
+
+                int res;
+
+                // comparison of page content
+                if (are_pages_identical(tracked_pages[i].ptr_to_pfn, tracked_pages[j].ptr_to_pfn)) {
+                    printk(KERN_INFO "OS_ASG: [IDENTICAL] 0x%lx == 0x%lx. Attempting Merge.\n", tracked_pages[i].page_addr, tracked_pages[j].page_addr);
+                    // acquire lock on mm_struct for the merge operation                    
+                    mmap_write_lock(mm);
+                    res = execute_pte_merge(mm, &tracked_pages[i], &tracked_pages[j]);
+
+                    if(res == 0) {
+						merged_total++;
+                        tracked_pages[j].is_merged = true;
+                    }
+                    else if (res == -EFAULT) {
+                        dedup_pr_err("dedup_phase: EFAULT - VMA missing at 0x%lx or 0x%lx\n", tracked_pages[i].page_addr, tracked_pages[j].page_addr);
+                    }
+                    else if (res == -ESTALE) {
+                        dedup_pr_err("dedup_phase: ESTALE - PTE unmapped or folio changed for pages 0x%lx and 0x%lx\n", tracked_pages[i].page_addr, tracked_pages[j].page_addr);
+                    }
+                    else if (res == -EADDRINUSE) {
+                        dedup_pr_err("dedup_phase: EADDRINUSE - target page 0x%lx is mapped elsewhere (mapcount > 1), cannot merge with 0x%lx\n", tracked_pages[j].page_addr, tracked_pages[i].page_addr);
+                    }
+                    else {
+                        dedup_pr_err("dedup_phase: Unknown error %d for pages 0x%lx and 0x%lx\n", res, tracked_pages[i].page_addr, tracked_pages[j].page_addr);
+                    }
+                mmap_write_unlock(mm); // release lock after merge attempt
+            }
+        }
+    }
+    
+printk(KERN_INFO "OS_ASG: [7] Cleanup Complete. Total Merged: %d\n", merged_total);
+    // final cleanup pass 
+    // release the reference (get_page/folio_get) taken during the initial Scan pass
+    for (int i = 0; i < count; i++) {
+        if (tracked_pages[i].is_allocated && tracked_pages[i].ptr_to_pfn) {
+            put_page(tracked_pages[i].ptr_to_pfn);
+            tracked_pages[i].ptr_to_pfn = NULL;
+        }
+    }
+
+
+
